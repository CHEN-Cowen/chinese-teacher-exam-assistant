# 复制为 backend.env 后填写真实值；backend.env 不得提交仓库。
# 密钥生成：openssl rand -hex 32

# 数据库连接：复用服务器上已有的 kaobian-postgres 容器（compose 已挂 kaobian-net 网络，
# 主机直接填容器名）。账号/密码/库名与服务器实际一致。
DATABASE_URL="postgresql://kaobian:替换为服务器PG密码@kaobian-postgres:5432/kaobian"
# 若 PostgreSQL 为宿主机直装（非容器）：compose 需给 migrate/backend 加
# extra_hosts: host.docker.internal:host-gateway，主机改为 host.docker.internal。

# 服务监听：容器内默认 3000，由 Docker 内网访问，不需要改
PORT=3000

# 位于 Next.js 反代之后（TLS 终止于 Caddy）
TRUST_PROXY=true

# 允许跨域来源（纵深防御；浏览器实际同源）：演示用 http://服务器公网IP，生产用 https://备案域名
CORS_ORIGINS="http://47.101.32.47"

# 内部反代密钥：与 frontend.env 的 INTERNAL_TOKEN 保持一致
INTERNAL_TOKEN="替换为强随机值"

# 受邀模式：只认真实会话 cookie；必须与前端 NEXT_PUBLIC_AUTH_MODE=invited 一致
AUTH_MODE=invited

# 首个管理员账号初始化引导令牌：调用管理账号初始化接口时携带，初始化完成后撤销/更换
ADMIN_BOOTSTRAP_TOKEN="替换为强随机值"

# ---- v7.2 主动抓取执行器 ----
# 抓取任务队列：compose 内已起 redis 服务（容器名 redis，仅内网可达）。
REDIS_URL="redis://redis:6379"

# 定时投递器：API 侧按来源到期时间投递发现任务；置 false 只用管理接口手动触发。
CRAWL_SCHEDULER_ENABLED=true

# Worker 服务（dist/worker.js）专用并发与暂停开关；置 CRAWL_WORKER_PAUSED=true
# 可单独暂停抓取消费（进程与心跳保留），不影响 backend/前端。
CRAWL_WORKER_CONCURRENCY=2
CRAWL_WORKER_PAUSED=false

# 队列投递重试与安全获取策略（均有内置默认值，通常无需修改）：
# CRAWL_QUEUE_ATTEMPTS=3
# CRAWL_QUEUE_BACKOFF_MS=1000
# CRAWL_ENQUEUE_TIMEOUT_MS=3000
# CRAWL_CONCURRENCY=1

# ---- 快照保留策略（单机小磁盘保护，务必在 API 侧开启，Worker 侧不要设）----
# 快照是内容寻址的，内容变一次就多一份不可变文件；列表页带访问计数器时每次抓取都变。
# 该策略只清理「HTML + 无任何引用 + 超出每 URL 保留版本数 + 早于 N 天」的历史版本，
# PDF/XLS 附件原件永远不会被清理。
#
# 先保持 DRY_RUN=true 跑一轮，看日志里的候选数量与可回收字节；
# 或直接调 GET /api/admin/sources/snapshots/retention/plan 预演，确认无误再改 false。
SNAPSHOT_RETENTION_ENABLED=true
SNAPSHOT_RETENTION_DRY_RUN=true
# 每个 (来源, URL) 下保留的 HTML 版本数
SNAPSHOT_RETENTION_KEEP_VERSIONS=20
# 只清理早于该天数的快照，避免打断正在进行的抓取/解析链
SNAPSHOT_RETENTION_MIN_AGE_DAYS=30
# 巡检间隔（毫秒），默认 6 小时；扫描上限默认 5000 条/轮
# SNAPSHOT_RETENTION_INTERVAL_MS=21600000
# SNAPSHOT_RETENTION_SCAN_LIMIT=5000
