# 复制为 deploy/.env，仅在部署服务器上填写；本文件不包含密钥。
GHCR_OWNER=chen-cowen
# 两个镜像由本仓库同一次提交构建，可分别固定到 sha-<完整提交SHA>。
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# 抓取队列 redis 镜像（独立 compose 亦引用）；境内拉不动时设 docker.nju.edu.cn/redis:7-alpine
# REDIS_IMAGE=redis:7-alpine

# 抓取 Worker 并发；CRAWL_WORKER_PAUSED=true 可单独暂停抓取消费而不下线进程（暂停不删除快照）
# 须与前端 NEXT_PUBLIC_FF_ACTIVE_CRAWL 由发布阶段同步设置（见 DEPLOYMENT.md 第 17 节）
# CRAWL_WORKER_CONCURRENCY=2
# CRAWL_WORKER_PAUSED=false

# 仅在准备好域名和 HTTPS 公开入口后设置，不要包含 https:// 前缀。
# SITE_DOMAIN=demo.example.com

# ---- v7.2 前端 Feature Flag（NEXT_PUBLIC_* 构建期内联进镜像：修改后必须重新构建前端镜像，不能只改本文件）----
# 默认关闭（未设置或非 "true" 一律关 = 保持 v7.1 现状行为）；严禁放任何密钥。
# NEXT_PUBLIC_FF_NEW_HOME=false
# NEXT_PUBLIC_FF_NEW_RESULTS=false
# NEXT_PUBLIC_FF_TARGETED_SUPPLEMENT=false
# NEXT_PUBLIC_FF_DB_CATALOG=   # 显式 true/false 优先；未设置时 production 开、dev/test 关（镜像后端 FF_DB_CATALOG）
# NEXT_PUBLIC_FF_ACTIVE_CRAWL=false   # 只控管理页可见性；与后端 CRAWL_WORKER_PAUSED 由发布阶段同步设置
# NEXT_PUBLIC_FF_POST_SAVE_NEXT=false

# ---- v7.2 后端目录开关（backend/src/catalog/feature-flag.ts）----
# 显式取值优先（on/off/true/false/1/0）；未设置时 production 默认开、dev/test 默认关。
# FF_DB_CATALOG=
