# 复制为 .env 后按环境填写；.env 不得提交仓库。
# 本文件只放占位符，请勿写入任何真实密钥。

# 数据库连接（本地开发可通过 SSH 隧道：ssh -L 5432:127.0.0.1:5432 <用户>@<服务器IP>）
DATABASE_URL="postgresql://kaobian:CHANGE_ME@localhost:5432/kaobian"

# 服务监听端口；容器内默认 3000
PORT=3000

# 监听地址：
# - 容器/Docker 网络部署保持默认 0.0.0.0（由安全组与网络隔离保证不可公网直连）；
# - Nginx 与本服务同机裸进程部署时设为 127.0.0.1，后端端口不对公网暴露。
# HOST=127.0.0.1

# 位于 Nginx 等反向代理之后时设为 true，以信任 X-Forwarded-*（TLS 终止于代理）
# TRUST_PROXY=true

# 允许跨域的前端来源，逗号分隔；受邀环境填备案产品域名
CORS_ORIGINS="http://localhost:3000"

# 内部反代密钥：Next.js 服务端代理经 x-internal-token 头携带。
# 本地开发不设置时守卫放行；受邀/正式环境必须设置强随机值（例如 openssl rand -hex 32）。
# INTERNAL_TOKEN=

# 运行模式：demo（默认，信任反代注入的演示身份头）/ invited（只认真实会话 cookie）。
# 受邀环境必须设为 invited，并与前端 NEXT_PUBLIC_AUTH_MODE 保持一致。
# AUTH_MODE=demo

# 首个管理员账号引导令牌：调用管理账号初始化接口时携带，初始化完成后撤销/更换。
# ADMIN_BOOTSTRAP_TOKEN=

# ---- v7.2 主动抓取执行器（队列 / Worker / 对象存储）----
# 本地开发可跑 `docker compose up redis` 或本机 redis-server；未设置时默认本机 6379。
# REDIS_URL="redis://127.0.0.1:6379"

# 抓取问题件快照目录（LocalObjectStore）：开发写本地目录，生产可换 OSS 实现。
# OBJECT_STORE_DIR=".data"

# 定时投递器：默认开启；置 false 只用管理接口手动触发。
# CRAWL_SCHEDULER_ENABLED=true
# 每轮扫描间隔（毫秒）与单轮批量
# CRAWL_SCHEDULER_INTERVAL_MS=60000
# CRAWL_SCHEDULER_BATCH=20

# Worker 进程（`node dist/worker.js`）专用：
# 消费并发；置 CRAWL_WORKER_PAUSED=true 可单独暂停消费而不下线进程（心跳照写）。
# 暂停不删除快照与来源暂停/恢复状态；须与前端 NEXT_PUBLIC_FF_ACTIVE_CRAWL 由发布阶段同步设置（见 DEPLOYMENT.md 第 17 节）。
# CRAWL_WORKER_CONCURRENCY=2
# CRAWL_WORKER_PAUSED=false

# 队列投递与重试（API 侧）：投递超时 / 最多尝试次数 / 指数退避基数（毫秒）
# CRAWL_ENQUEUE_TIMEOUT_MS=3000
# CRAWL_QUEUE_ATTEMPTS=3
# CRAWL_QUEUE_BACKOFF_MS=1000

# 安全获取（SafeFetcher）策略：最大重定向、连接/总超时、响应体上限、UA、重试
# CRAWL_MAX_REDIRECTS=3
# CRAWL_CONNECT_TIMEOUT_MS=5000
# CRAWL_TOTAL_TIMEOUT_MS=15000
# CRAWL_MAX_BYTES=8388608
# CRAWL_USER_AGENT="JiaozhaoYoujuBot/1.0 (+official-source-fetch)"
# CRAWL_RETRY_ATTEMPTS=3
# CRAWL_RETRY_BASE_DELAY_MS=200
# 同为来源抓取的默认同域并发上限（默认 1，尊重 Retry-After）
# CRAWL_CONCURRENCY=1

# ---- v7.2 数据库目录开关（backend/src/catalog/feature-flag.ts，消费方 opportunities.service）----
# 显式取值优先（on/off/true/false/1/0）；未设置时 production 默认开、dev/test 默认关。
# 开：用户端匹配只读数据库 PublishedAnnouncementVersion(status=published)，静态演示/台账目录一律不参与；
# 关：沿用静态目录（滚动演示 + 真实台账），仅用于 Demo 与测试。
# FF_DB_CATALOG=

# ---- v7.2 前端 Feature Flag（NEXT_PUBLIC_* 构建期内联进浏览器产物，仅当同一环境构建前端时相关）----
# 默认关闭（未设置或非 "true" 一律关 = 保持 v7.1 现状行为；NEXT_PUBLIC_FF_DB_CATALOG 除外：
# 显式 true/false 优先，未设置时 production 开、dev/test 关）。
# 修改后必须重新构建前端才生效，不能只改运行时环境变量；严禁放任何密钥。
# NEXT_PUBLIC_FF_NEW_HOME=false
# NEXT_PUBLIC_FF_NEW_RESULTS=false
# NEXT_PUBLIC_FF_TARGETED_SUPPLEMENT=false
# NEXT_PUBLIC_FF_DB_CATALOG=
# NEXT_PUBLIC_FF_ACTIVE_CRAWL=false   # 只控管理页可见性；与后端 CRAWL_WORKER_PAUSED 由发布阶段同步设置
# NEXT_PUBLIC_FF_POST_SAVE_NEXT=false
