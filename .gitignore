# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 允许提交不含真实值的环境变量示例文件
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# 受邀部署密钥仅保留在服务器；允许提交不含真实值的镜像选择模板
/deploy/*.env
!/deploy/.env.example

# standalone 部署的本地数据目录（PostgreSQL 库文件与公告快照）
/deploy/data/

# 浏览器端到端测试的本地依赖和运行产物
/.qa-harness/node_modules/
/.qa-harness/shots/
/.qa-harness/test-results/
/.qa-harness/playwright-report/
/.qa-harness/.auth/

# ===== [项目特有] 历史遗留与编辑器缓存（非源码，不跟踪）=====
/.legacy-git-metadata/
/.merge-primary-repo/
/.trae/

# 本地抓取/探针临时产物
/.tmp-probe/
/.workbuddy/
/outputs/

# ===== 嵌套 frontend 子目录构建副本（主工程在根目录，子目录是误入的构建产物）=====
/frontend/

# ===== 发布与构建压缩包 =====
/*.tgz
/deploy/*.tgz
/deploy/release-*.tgz
/*.zip

# ===== 受邀部署敏感凭据（私钥/公钥/token，绝不提交）=====
/deploy/aliyun_ed25519
/deploy/aliyun_ed25519.pub
/deploy/internal-token.txt
